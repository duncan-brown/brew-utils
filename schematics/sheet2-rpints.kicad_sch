	(text "Sheet 2 — rpints: PANP buttons and lamps, dash power relays, the flow-meter relays, the serving and lagering keezer sensors, the RaspberryPints Uno, the right switch pod, and the serial buses to the tacho and dummy boards." (exclude_from_sim no) (at 10.16 10.16 0) (effects (font (size 1.6 1.6)) (justify left top)) (uuid "bb2590d0-0de5-4b78-a2ed-bac3c3d62f6a"))
	(text "Cross-sheet nets are global labels.  RPINTS_* nets are the rpints HAT; BREWPI_* nets come from sheet 3; P1_+12V and DASH_POWER_+12V from sheet 1." (exclude_from_sim no) (at 10.16 15.24 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "06017900-9b6e-4d20-ab79-fd9ba4f79207"))
